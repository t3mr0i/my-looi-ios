{
  "expo": {
    "name": "My LOOI",
    "slug": "my-looi",
    "version": "2.1.151",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "mylooi",
    "userInterfaceStyle": "automatic",
    "locales": {
      "de": "./assets/locales/de.json",
      "en": "./assets/locales/en.json",
      "uk": "./assets/locales/uk.json",
      "ru": "./assets/locales/ru.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.razor79.mylooi",
      "buildNumber": "41",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.razor79.mylooi",
      "versionCode": 151
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-vosk-command-models",
      "./plugins/with-react-native-webrtc",
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Looi to record voice commands",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": false,
          "bluetoothAlwaysPermission": "Allow Looi to connect to the LOOI robot over Bluetooth"
        }
      ],
      "@siteed/sherpa-onnx.rn/app.plugin",
      [
        "@siteed/audio-studio",
        {
          "enablePhoneStateHandling": false,
          "enableNotifications": false,
          "enableBackgroundAudio": false,
          "enableDeviceDetection": false,
          "iosConfig": {
            "microphoneUsageDescription": "Allow Looi to listen for the wake word and voice commands"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "./plugins/with-looi-ios"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
